# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor (opcionales; sin ellas el calendario aparece "sin configurar")
# Cliente OAuth de Google Cloud (el mismo que usa Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave para cifrar tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# IA gratuita para nutrición (opcional; sin ellas los botones de IA avisan de que falta configurarla)
# Gemini: clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Respaldo opcional: Groq (free tier) https://console.groq.com/keys
GROQ_API_KEY=
# Más respaldos gratuitos (opcionales; se prueban en orden si el anterior falla)
# Mistral: https://console.mistral.ai/api-keys (plan Experiment, gratis)
MISTRAL_API_KEY=
# OpenRouter: https://openrouter.ai/keys (usa sus modelos «:free»)
OPENROUTER_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Orden de prueba (opcional), p. ej. groq,gemini,mistral,openrouter,cerebras
AI_PROVIDERS=

# Estudio de vídeo: clips de stock (Pixabay gratis en https://pixabay.com/api/docs)
PIXABAY_API_KEY=
