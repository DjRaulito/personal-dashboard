# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor (opcionales; sin ellas el calendario aparece "sin configurar")
# Cliente OAuth de Google Cloud (el mismo que usa Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave para cifrar tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# IA gratuita para nutrición (opcional; sin ellas los botones de IA avisan de que falta configurarla)
# Gemini: clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Respaldo opcional: Groq (free tier) https://console.groq.com/keys
GROQ_API_KEY=
